---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getContent } from "@/lib/content";
import { LOCALES, fillTemplate, localize } from "@/lib/i18n";
import { buildNotFoundHead } from "@/lib/seo";

// One page for both languages: a missing URL has no active language (D-090).
const content = await getContent();
const { ui } = content;
const head = buildNotFoundHead(content);
const year = String(new Date().getFullYear());
---

<BaseLayout lang="es" head={head} skipLinkLabel={localize(ui.skipLink, "es")}>
  <a slot="header" href="/es" aria-label={localize(ui.home.logoLabel, "es")}>
    UV
  </a>

  <div data-tone="dark" class="bg-bg text-text">
    <div class="mx-auto max-w-(--size-container) px-(--space-gutter) py-(--space-section)">
      <h1 class="text-h2">
        {LOCALES.map((locale) => (
          <span lang={locale} class="block">
            {localize(ui.notFound.title, locale)}
          </span>
        ))}
      </h1>
      {LOCALES.map((locale) => (
        <div lang={locale}>
          <p>{localize(ui.notFound.body, locale)}</p>
          <a href={`/${locale}`}>{localize(ui.notFound.back, locale)}</a>
        </div>
      ))}
    </div>
  </div>

  <p
    slot="footer"
    class="mx-auto max-w-(--size-container) px-(--space-gutter) py-8 text-small"
  >
    {fillTemplate(localize(ui.footer.rights, "es"), { year })}
  </p>
</BaseLayout>
