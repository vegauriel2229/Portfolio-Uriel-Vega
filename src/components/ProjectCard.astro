---
import type { Content } from "@/lib/content";
import { localize, type Locale } from "@/lib/i18n";
import ExternalLinkIcon from "@/components/icons/ExternalLinkIcon.astro";

interface Props {
  locale: Locale;
  project: Content["projects"][number];
  ui: Content["ui"];
  featured: boolean;
}

const { locale, project, ui, featured } = Astro.props;

// Links that are not publishable are not drawn and leave no space (R4.3).
const links = project.links.filter((link) => link.publishable);
---

<article
  class:list={[
    "max-w-[58rem] rounded-lg border border-hair bg-surface p-(--space-card)",
    featured && "border-t-4 border-t-accent",
  ]}
>
  <h3 class:list={[featured ? "text-h3-lg" : "text-h3"]}>{project.name}</h3>
  <p class="mt-3 max-w-[58ch]">{localize(project.summary, locale)}</p>
  <dl class="mt-5 grid gap-3">
    <div>
      <dt class="text-small text-muted">
        {localize(ui.fields.status, locale)}
      </dt>
      <dd class="flex items-center gap-2 font-bold">
        <span
          aria-hidden="true"
          class="size-2.5 shrink-0 rounded-full bg-mark"
        ></span>
        {localize(project.status, locale)}
      </dd>
    </div>
    <div>
      <dt class="text-small text-muted">
        {localize(ui.fields.technologies, locale)}
      </dt>
      <dd class="font-bold">{project.technologies.join(", ")}</dd>
    </div>
  </dl>
  {links.length > 0 && (
    <ul class="mt-6 flex flex-col gap-3 md:flex-row md:flex-wrap">
      {links.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="press inline-flex min-h-12 items-center gap-2 rounded-full border-2 border-link px-5 text-label font-bold text-link hover:bg-link hover:text-bg"
          >
            {localize(link.label, locale)}
            <ExternalLinkIcon class="size-5 shrink-0" />
            <span class="sr-only">{localize(ui.external.newTab, locale)}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</article>
