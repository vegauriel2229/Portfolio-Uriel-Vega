---
import type { Content } from "@/lib/content";
import { localize, type Locale } from "@/lib/i18n";
import MenuIcon from "@/components/icons/MenuIcon.astro";
import PawIcon from "@/components/icons/PawIcon.astro";
import PawOffIcon from "@/components/icons/PawOffIcon.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

interface Props {
  locale: Locale;
  ui: Content["ui"];
}

const { locale, ui } = Astro.props;

// Same list feeds the inline navigation (from lg) and the mobile menu (design section 6.5.1).
const items = [
  { id: "projects", label: ui.sections.projects },
  { id: "current-work", label: ui.sections.currentWork },
  { id: "about", label: ui.sections.about },
  { id: "skills", label: ui.sections.skills },
  { id: "contact", label: ui.sections.contact },
];
---

<header
  data-tone="deep"
  class="sticky top-0 z-50 border-b border-hair bg-bg-deep text-text [@media(max-height:30rem)]:static"
>
  <div class="wrap flex min-h-(--size-header) items-center gap-1 min-[22rem]:gap-2 lg:gap-3">
    <a
      href="#home"
      aria-label={localize(ui.home.logoLabel, locale)}
      class="tap tap-lift inline-flex size-(--size-touch) shrink-0 items-center justify-center rounded-full border-[1.5px] border-accent font-display text-label font-semibold text-accent hover:border-text hover:text-text"
    >
      UV
    </a>
    <nav
      aria-label={localize(ui.nav.label, locale)}
      class="order-last lg:order-none lg:mx-auto"
    >
      <ul class="hidden items-center gap-6 lg:flex">
        {items.map(({ id, label }) => (
          <li>
            <a
              href={`#${id}`}
              class="navlink inline-flex min-h-(--size-touch) items-center text-label font-bold"
            >
              {localize(label, locale)}
            </a>
          </li>
        ))}
      </ul>
      <details data-menu class="lg:hidden">
        <summary
          aria-label={localize(ui.nav.menu, locale)}
          class="tap tap-lift inline-flex min-h-(--size-touch) w-(--size-touch) cursor-pointer list-none items-center justify-center gap-0 rounded-full border border-line px-0 text-label font-bold min-[22rem]:w-auto min-[22rem]:gap-2 min-[22rem]:px-4 hover:border-text [&::-webkit-details-marker]:hidden"
        >
          <MenuIcon class="size-5" />
          <span class="hidden min-[22rem]:inline">
            {localize(ui.nav.menu, locale)}
          </span>
        </summary>
        <ul class="absolute inset-x-0 top-full border-b border-hair bg-surface">
          {items.map(({ id, label }) => (
            <li class="border-b border-hair last:border-b-0">
              <a
                href={`#${id}`}
                class="wrap flex min-h-12 items-center text-label font-bold hover:text-accent hover:underline hover:decoration-2 hover:underline-offset-4 active:text-accent"
              >
                {localize(label, locale)}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
    {/* Mascot toggle (T9, design sections 6.5.1 and 6.10.6): next to the ES/EN group and
        outside it, preceded by a decorative rule. Rendered hidden; JavaScript shows it. */}
    <div class="ml-auto flex items-center gap-1 lg:ml-0">
      <LanguageSwitcher locale={locale} ui={ui} />
      <span aria-hidden="true" class="h-6 w-px shrink-0 bg-hair"></span>
      <button
        type="button"
        data-mascot-toggle
        hidden
        aria-label={localize(ui.mascot.hide, locale)}
        data-label-hide={localize(ui.mascot.hide, locale)}
        data-label-show={localize(ui.mascot.show, locale)}
        class="mascot-toggle"
      >
        <span class="mascot-toggle-ring" data-mascot-icon="hide">
          <PawIcon />
        </span>
        <span class="mascot-toggle-ring" data-mascot-icon="show" hidden>
          <PawOffIcon />
        </span>
      </button>
    </div>
  </div>
</header>
