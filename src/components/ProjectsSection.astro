---
import type { Content } from "@/lib/content";
import { localize, type Locale } from "@/lib/i18n";
import ProjectCard from "@/components/ProjectCard.astro";

interface Props {
  locale: Locale;
  content: Content;
}

const { locale, content } = Astro.props;
const { projects, ui } = content;
---

<section
  id="projects"
  data-tone="base"
  aria-labelledby="projects-title"
  class="bg-bg text-text"
>
  <div class="wrap py-(--space-section)">
    <h2 id="projects-title" class="text-h2">
      {localize(ui.sections.projects, locale)}
    </h2>
    <div class="mt-8 grid gap-8">
      {projects.map((project, index) => (
        <ProjectCard
          locale={locale}
          project={project}
          ui={ui}
          featured={index === 0}
        />
      ))}
    </div>
  </div>
</section>
