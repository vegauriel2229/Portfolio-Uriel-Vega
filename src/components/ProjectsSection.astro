---
import type { Content } from "@/lib/content";
import { localize, type Locale } from "@/lib/i18n";
import ProjectCard from "@/components/ProjectCard.astro";

interface Props {
  locale: Locale;
  content: Content;
}

const { locale, content } = Astro.props;
const { projects, ui } = content;
---

<section
  id="projects"
  data-tone="base"
  aria-labelledby="projects-title"
  class="bg-bg text-text"
>
  <div class="wrap py-(--space-section)">
    <h2
      id="projects-title"
      data-reveal="rise"
      class="mask text-h2 text-balance"
    >
      <span>
        <span data-platform="letters">
          {localize(ui.sections.projects, locale)}
        </span>
      </span>
    </h2>
    <div class="mt-8 grid gap-16 min-[900px]:gap-24">
      {projects.map((project) => (
        <ProjectCard
          locale={locale}
          project={project}
          ui={ui}
          featured={project.featured}
        />
      ))}
    </div>
  </div>
</section>
