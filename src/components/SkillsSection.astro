---
import type { Content } from "@/lib/content";
import { localize, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
  content: Content;
}

const { locale, content } = Astro.props;
const { skills, skillLevels, projects, ui } = content;

// D-164: the order of the data file, not alphabetical.
const LEVELS = ["advanced", "intermediate", "basic"] as const;

// Groups in the order Advanced, Intermediate, Basic; inside each one, the order of the data.
const groups = LEVELS.map((id) => ({
  id,
  level: skillLevels[id]!,
  // Hidden text read after each name: "Python, nivel Avanzado" (R7.5).
  levelText: `${localize(ui.skills.levelPrefix, locale)} ${localize(skillLevels[id]!.label, locale)}`,
  skills: skills.filter((skill) => skill.level === id),
})).filter((group) => group.skills.length > 0);

const projectName = (id: string): string =>
  projects.find((project) => project.id === id)?.name ?? id;
---

<section
  id="skills"
  data-tone="deep"
  aria-labelledby="skills-title"
  class="bg-bg text-text"
>
  <div class="wrap py-(--space-section)">
    <h2 id="skills-title" data-reveal="rise" class="mask text-h2 text-balance">
      <span>
        <span data-platform="letters">
          {localize(ui.sections.skills, locale)}
        </span>
      </span>
    </h2>

    <div class="mt-8">
      {groups.map((group) => (
        <div class="grid gap-4 border-t border-hair py-7 min-[900px]:grid-cols-[4fr_7fr] min-[900px]:gap-16">
          <div>
            <h3 class="text-h3">
              <span data-platform="letters">
                {localize(group.level.label, locale)}
              </span>
            </h3>
            <p class="mt-2 max-w-[34ch] text-small text-muted">
              {localize(group.level.definition, locale)}
            </p>
          </div>
          {/* D-167: violet terminal window. Every skill is a `$ name` line and
              `backedBy` follows as `# …` comment lines. Complete without JS:
              the typing entrance only runs under [data-terminals-live]. */}
          <div data-terminal class="term">
            <div aria-hidden="true" class="term-bar">
              <i></i>
              <i></i>
              <i></i>
            </div>
            <ul role="list" class="term-lines">
              {group.skills.map((skill) => (
                <>
                  <li data-term-line class="term-line">
                    <span aria-hidden="true" class="term-prompt">
                      $
                    </span>
                    <span class="term-text">
                      {localize(skill.name, locale)}
                      <span class="sr-only">{group.levelText}</span>
                    </span>
                  </li>
                  {skill.backedBy.length > 0 && (
                    <li data-term-line class="term-line term-comment">
                      <span aria-hidden="true" class="term-prompt">
                        #
                      </span>
                      <span class="term-text">
                        {localize(ui.skills.backedBy, locale)}{" "}
                        {skill.backedBy
                          .map((ref) => projectName(ref.id))
                          .join(", ")}
                      </span>
                    </li>
                  )}
                </>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
