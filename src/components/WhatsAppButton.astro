---
import type { Content } from "@/lib/content";
import { localize, type Locale } from "@/lib/i18n";
import WhatsAppIcon from "@/components/icons/WhatsAppIcon.astro";

interface Props {
  locale: Locale;
  content: Content;
}

const { locale, content } = Astro.props;
const { profile, ui } = content;

// The visible text "WhatsApp" is contained in the accessible name (WCAG 2.5.3, R9.3).
// This is the last element of the page: Tab reaches it after the footer and Enter activates it (R9.5).
const accessibleName = `${localize(profile.contact.labels.whatsapp, locale)} ${localize(ui.external.newTab, locale)}`;
---

<a
  href={profile.contact.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={accessibleName}
  class="tap tap-zoom fixed right-[max(1rem,env(safe-area-inset-right))] bottom-[max(1rem,env(safe-area-inset-bottom))] z-60 inline-flex size-14 items-center justify-center gap-2 rounded-full bg-accent text-bg-deep shadow-wa hover:bg-text focus-visible:shadow-wa-focus focus-visible:outline-hidden md:right-6 md:bottom-6 md:w-auto md:px-5"
>
  <WhatsAppIcon class="size-[26px] shrink-0" />
  <span class="hidden text-label font-bold md:inline">
    {localize(ui.whatsapp.floatLabel, locale)}
  </span>
</a>
