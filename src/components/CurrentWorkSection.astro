---
import type { Content } from "@/lib/content";
import { localize, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
  content: Content;
}

const { locale, content } = Astro.props;
// "Under construction" look: dashed border, no surface, hollow marker (R5.2). No links or buttons (R5.3).
const { currentWork, ui } = content;
---

<section
  id="current-work"
  data-platform="edge"
  data-tone="deep"
  aria-labelledby="current-work-title"
  class="bg-bg text-text"
>
  <div class="wrap py-(--space-section)">
    <h2
      id="current-work-title"
      data-reveal="rise"
      class="mask text-h2 text-balance"
    >
      <span>
        <span data-platform="letters">
          {localize(ui.sections.currentWork, locale)}
        </span>
      </span>
    </h2>
    <article
      data-platform="card"
      data-reveal="fade"
      class="mt-8 max-w-[58rem] rounded-lg border-2 border-dashed border-line bg-bg p-(--space-card)"
    >
      <h3 class="text-h3-lg">
        <span data-platform="letters">
          {localize(currentWork.title, locale)}
        </span>
      </h3>
      <p class="mt-3 max-w-[58ch]">
        {localize(currentWork.description, locale)}
      </p>
      <dl class="mt-5 grid gap-3">
        <div>
          <dt class="text-small text-muted">
            {localize(ui.fields.status, locale)}
          </dt>
          <dd class="flex items-center gap-2 font-bold">
            <span
              aria-hidden="true"
              class="size-2.5 shrink-0 rounded-full border-2 border-signal"
            ></span>
            {localize(currentWork.status, locale)}
          </dd>
        </div>
        <div>
          <dt class="text-small text-muted">
            {localize(ui.fields.progress, locale)}
          </dt>
          <dd class="font-bold">{localize(currentWork.progress, locale)}</dd>
        </div>
      </dl>
    </article>
  </div>
</section>
