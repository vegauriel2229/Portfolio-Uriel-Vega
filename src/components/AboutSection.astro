---
import AiTimeline from "@/components/AiTimeline.astro";
import type { Content } from "@/lib/content";
import { localize, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
  content: Content;
}

const { locale, content } = Astro.props;
const { profile, ui } = content;

// The 6 hiring facts (R6.1); the first 3 are the same keys shown in the home (R6.4).
const facts = [
  { label: ui.hiring.location, value: profile.hiring.location, wide: false },
  { label: ui.hiring.workMode, value: profile.hiring.workMode, wide: false },
  { label: ui.hiring.seeking, value: profile.hiring.seeking, wide: false },
  {
    label: ui.hiring.availability,
    value: profile.hiring.availability,
    wide: false,
  },
  { label: ui.hiring.education, value: profile.hiring.education, wide: true },
  { label: ui.hiring.english, value: profile.hiring.english, wide: false },
];

// The AI paragraph (ia-sdd, the last one) lives in the AI block, unchanged (R6.3).
const paragraphs = profile.about.paragraphs.filter(
  (paragraph) => paragraph.id !== "ia-sdd",
);
const aiParagraph = profile.about.paragraphs.find(
  (paragraph) => paragraph.id === "ia-sdd",
);
---

<section
  id="about"
  data-tone="base"
  aria-labelledby="about-title"
  class="bg-bg text-text"
>
  <div class="wrap py-(--space-section)">
    <h2 id="about-title" data-reveal="rise" class="mask text-h2 text-balance">
      <span>
        <span data-platform="letters">
          {localize(ui.sections.about, locale)}
        </span>
      </span>
    </h2>

    <h3 class="mt-8 text-h3">
      <span data-platform="letters">{localize(ui.hiring.heading, locale)}</span>
    </h3>
    <dl data-reveal="fade" class="mt-5 grid gap-x-8 gap-y-4 md:grid-cols-2">
      {facts.map(({ label, value, wide }) => (
        <div class:list={[wide && "md:col-span-2"]}>
          <dt class="text-small text-muted">{localize(label, locale)}</dt>
          <dd class="font-bold">{localize(value, locale)}</dd>
        </div>
      ))}
    </dl>

    <div data-reveal="fade" class="mt-10 grid max-w-[58ch] gap-4">
      {paragraphs.map((paragraph) => (
        <p>{paragraph[locale]}</p>
      ))}
    </div>

    {/* AI block (R6.3, D-104): heading and paragraph in normal flow, then the Orchestra timeline (T7, R24). */}
    <section aria-labelledby="ai-title" class="mt-12">
      <h3 id="ai-title" class="text-h3">
        <span data-platform="letters">
          {localize(ui.timeline.title, locale)}
        </span>
      </h3>
      {aiParagraph && (
        <p
          data-reveal="fade"
          class="mt-4 max-w-[58ch] border-l-4 border-accent pl-5 text-lead"
        >
          {aiParagraph[locale]}
        </p>
      )}
      <div class="mt-8">
        <AiTimeline locale={locale} content={content} />
      </div>
    </section>
  </div>
</section>
